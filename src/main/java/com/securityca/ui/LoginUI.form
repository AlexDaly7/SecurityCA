<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.securityca.ui.LoginUI">
  <grid id="27dc6" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <enabled value="true"/>
      <maximumSize width="500" height="150"/>
      <minimumSize width="500" height="150"/>
      <preferredSize width="500" height="150"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="9c639" class="javax.swing.JPasswordField" binding="PasskeyField">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <maximumSize width="250" height="35"/>
          <minimumSize width="250" height="35"/>
          <preferredSize width="250" height="35"/>
        </properties>
      </component>
      <component id="106ff" class="javax.swing.JButton" binding="loginButton" default-binding="true">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Login"/>
        </properties>
      </component>
      <component id="dbe86" class="javax.swing.JLabel" binding="PasskeyLabel">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties>
          <text value="Enter Passkey"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
