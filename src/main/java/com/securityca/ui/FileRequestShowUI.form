<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.securityca.ui.FileRequestShowUI">
  <grid id="27dc6" layout-manager="GridLayoutManager" row-count="4" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <preferredSize width="500" height="500"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="b542b" class="javax.swing.JList" binding="FileList">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="2" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="250" height="50"/>
          </grid>
        </constraints>
        <properties>
          <model/>
          <selectionMode value="0"/>
          <valueIsAdjusting value="false"/>
        </properties>
      </component>
      <component id="d4503" class="javax.swing.JButton" binding="requestFileButton" default-binding="true">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Request File"/>
        </properties>
      </component>
      <vspacer id="3b931">
        <constraints>
          <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="10"/>
            <preferred-size width="-1" height="10"/>
            <maximum-size width="-1" height="10"/>
          </grid>
        </constraints>
      </vspacer>
      <hspacer id="804a3">
        <constraints>
          <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="1" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="10" height="-1"/>
            <preferred-size width="10" height="-1"/>
            <maximum-size width="10" height="-1"/>
          </grid>
        </constraints>
      </hspacer>
      <hspacer id="b5259">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="5" height="-1"/>
            <preferred-size width="5" height="-1"/>
            <maximum-size width="5" height="-1"/>
          </grid>
        </constraints>
      </hspacer>
      <vspacer id="a9a87">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="5"/>
            <preferred-size width="-1" height="5"/>
            <maximum-size width="-1" height="5"/>
          </grid>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
