<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="StartupWindow">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="492" height="312"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="4e906" binding="tabsPanel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="200"/>
          </grid>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="35001" layout-manager="GridBagLayout">
            <constraints>
              <tabbedpane title="Host Server"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="95fbc" class="javax.swing.JButton" binding="startButton" default-binding="true">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="0.0" weighty="1.0"/>
                </constraints>
                <properties>
                  <text value="Start"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="a82c6" layout-manager="GridBagLayout">
            <constraints>
              <tabbedpane title="Connect"/>
            </constraints>
            <properties/>
            <border type="empty">
              <size top="4" left="4" bottom="4" right="4"/>
            </border>
            <children>
              <component id="41c01" class="javax.swing.JTextField" binding="ipTextFld">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="127.0.0.1"/>
                </properties>
              </component>
              <component id="6f797" class="javax.swing.JLabel">
                <constraints>
                  <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Port (default 5000)"/>
                </properties>
              </component>
              <component id="29bbf" class="javax.swing.JTextField" binding="portTextFld">
                <constraints>
                  <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="-1"/>
                  </grid>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="5000"/>
                </properties>
              </component>
              <component id="515e5" class="javax.swing.JLabel">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="IP Address"/>
                </properties>
              </component>
              <component id="7ae6f" class="javax.swing.JButton" binding="connectBtn">
                <constraints>
                  <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                  <gridbag weightx="1.0" weighty="0.0"/>
                </constraints>
                <properties>
                  <text value="Connect"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
